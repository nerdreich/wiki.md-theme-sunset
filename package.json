{
  "name": "wiki.md-theme-sunset",
  "version": "2.4.1-dev1",
  "description": "A wiki.md theme built around the Averia font family.",
  "type": "module",
  "keywords": [
    "wiki.md",
    "theme",
    "PHP",
    "responsive"
  ],
  "engines": {
    "npm": ">=8.0.0"
  },
  "author": "Markus Leupold-Löwenthal",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/nerdreich/wiki.md-theme-sunset",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerdreich/wiki.md-theme-sunset"
  },
  "bugs": {
    "url": "https://github.com/nerdreich/wiki.md-theme-sunset/issues"
  },
  "scripts": {
    "dist": "gulp dist",
    "package": "npm-run-all lint gulp:package package:tgz",
    "package:tgz": "tar --sort=name -C ./dist/themes -czvf dist/wiki.md-theme-sunset-${npm_package_version}.tar.gz wiki.md-theme-sunset",
    "gulp": "gulp",
    "gulp:package": "gulp package",
    "lint": "npm-run-all lint:prettier lint:stylelint lint:eslint lint:phpcbf lint:phpcs lint:standard",
    "lint:phpcbf": "tools/phpcbf.phar --standard=PSR12 src/php/",
    "lint:phpcs": "tools/phpcs.phar --standard=PSR12 src/php/",
    "lint:eslint": "eslint --fix --ext .js,.mjs .",
    "lint:prettier": "prettier -w 'src/**/*.scss'",
    "lint:stylelint": "stylelint --fix 'src/**/*.scss'",
    "lint:standard": "standard --fix"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "babelify": "10.0.0",
    "browserify": "17.0.1",
    "del": "8.0.1",
    "eslint": "10.1.0",
    "globals": "17.4.0",
    "gulp": "5.0.1",
    "gulp-autoprefixer": "10",
    "gulp-concat": "2.6.1",
    "gulp-gzip": "1.4.2",
    "gulp-replace": "1.1.4",
    "gulp-sass": "6.0.1",
    "gulp-sort": "2.0.0",
    "gulp-tar": "5.0.0",
    "gulp-zip": "6.1.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.1",
    "sass": "1.98.0",
    "standard": "17.1.2",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-sass-guidelines": "13.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "stylelint-scss": "7.0.0",
    "vinyl-source-stream": "2.0.0"
  },
  "dependencies": {
    "bootstrap": "5.3.8"
  },
  "xoverrides": {
    "chokidar": "3.5.3",
    "glob-parent": "6.0.2"
  },
  "bgColor": "#223240"
}
